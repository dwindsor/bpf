# SPDX-License-Identifier: Apache-2.0
#
# Merged over `defconfig kvm_guest.config` by kernel/build.sh. Every line here is
# something a lineage carrier or a scenario stops working without, which is why
# build.sh asserts each one survived olddefconfig instead of trusting it.

# The datapath: BPF LSM programs attach through a trampoline, which needs BTF and
# ftrace direct calls, and the loader needs BPF_EVENTS for its ring buffer.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_LSM=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_KPROBES=y
CONFIG_PERF_EVENTS=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y

# The LSM itself, and the integrity stack the demo's lsm= cmdline names.
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_INTEGRITY=y

# The carriers. security.* xattrs are a per-filesystem feature: without
# EXT4_FS_SECURITY a birth label is written to an inode that cannot store it, and
# without TMPFS_XATTR the scenarios' scratch files lose theirs.
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y

# The repo reaches the guest over 9p, and cgroups key the declassifier.
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y

# A shebang is how a scenario proves a tenant-derived file is refused as a program
# image, and sysrq is how the guest powers off in a rootfs with no init system.
CONFIG_BINFMT_SCRIPT=y
CONFIG_MAGIC_SYSRQ=y

# uname -r has to say which of the two kernels a transcript ran on -- build.sh sets
# LOCALVERSION to -lineage or -stock. Left on, AUTO would append -dirty to the
# first, because the series is applied with `git apply` and never committed, and
# then the two builds would differ only by a word that means "uncommitted".
# CONFIG_LOCALVERSION_AUTO is not set
